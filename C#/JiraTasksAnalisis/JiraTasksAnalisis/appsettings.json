{ 
  "JiraToken": "[test]",   
  "Interval_type": "AFTER",
  "Interval": "8", 
  "Date_collum": "A",
  "Projects": 
  [
    {
      "Project": "Project1",
      "GoogleSheet": "1qbK9eUH-...",
      "Teams": [
        {
          "Name": "Team1",
          "filter": "component not in (design) and type  not in (Sub-story)"
        }
      ],
      "Filtres": [
        {
          "Name": "filter_count_close_or_reopen",
          "Title": "Количество задач готовы к деплою, закрыты или переоткрыты",
          "filter": "status changed FROM  (\"TESTING\", TESTREADY) to (\"DONE\",\"TESTDONE\",\"DEVELOP\", NEW)",
          "JqlOverride": "",
          "Period": "interval",
          "collum": "B"
        },
        {
          "Name": "filter_count_reopen",
          "Title": "Количество переоткрытых задач",
          "filter": "status changed FROM  (\"TESTING\") to (\"DEVELOP\", NEW)",
          "JqlOverride": "",
          "Period": "interval",
          "collum": "C"
        },
        {
          "Name": "filter_count_to_TESTREADY",
          "Title": "Доставлено до тестирования",
          "filter": "status changed FROM  (\"DEVELOP\",REVIEW) to (\"TESTREADY\")",
          "JqlOverride": "",
          "Period": "interval",
          "collum": "D"
        },
        {
          "Name": "filter_count_status_today_old",
          "Title": "Количество задач на команде QA",
          "filter": "status in (\"TESTING\", TESTREADY)",
          "JqlOverride": "",
          "Period": "today",
          "collum": "E"
        },
		{
          "Name": "filter_count_status_today",
          "Title": "Количество задач на команде QA",
          "filter": "status in (\"TESTING\", TESTREADY) and ( Sprint is EMPTY or Sprint in openSprints())",
          "JqlOverride": "",
          "Period": "today",
          "collum": "F"
        },
		{
          "Name": "filter_count_subtask_created",
          "Title": "Количество созданных sub-task",
          "filter": "issuetype = Sub-bug AND created >= -7d",
          "JqlOverride": "",
          "Period": "today",
          "collum": "G"
        },
        {
          "Name": "filter_time_TESTREADY",
          "Title": "Среднее количество дней, которое задачи провели в статусе TESTREADY",
          "filter": "TESTREADY",
          "JqlOverride": "",
          "Period": "interval",
          "collum": "H"
        },
        {
          "Name": "filter_time_in_testing",
          "Title": "Среднее количество дней, которое задачи провели в статусе TESTING",
          "filter": "TESTING",
          "JqlOverride": "",
          "Period": "interval",
          "collum": "I"
        },
        {
          "Name": "filter_time_TESTDONE",
          "Title": "Среднее количество дней, которое задачи провели в статусе TESTDONE",
          "filter": "TESTDONE",
          "JqlOverride": "",
          "Period": "interval",
          "collum": "J"
        }
      ]
    },
    {
      "Project": "Project2",
      "GoogleSheet": "test",
      "Teams": [
        {
          "Name": "Team2",
          "filter": ""
        },
        {
          "Name": "Team Games",
          "filter": "component = Игры"
        },
        {
          "Name": "CG_Microservices",
          "filter": "labels = microservices"
        },
        {
          "Name": "CG_Client",
          "filter": "component = Клиент"
        },
        {
          "Name": "Backend. All",
          "filter": "component = Backend and (labels not in (py_to_csharp, microservices) or labels is EMPTY or  parent != CLOUDGAMES-30075)"
        }
      ],
      "Filtres": [
        {
          "Name": "filter_count_close_or_reopen",
          "Title": "Количество задач готовы к деплою, закрыты или переоткрыты",
          "filter": "status changed FROM  (\"in testing\", resolved) to (\"closed\",\"ready to deploy\",\"READY TO WORK\")",
          "JqlOverride": "",
          "Period": "interval",
          "collum": "B"
        },
        {
          "Name": "filter_count_to_resolved",
          "Title": "Доставлено до тестирования",
          "filter": "status changed to (\"resolved\")",
          "JqlOverride": "",
          "Period": "interval",
          "collum": "C"
        },
        {
          "Name": "filter_count_status_today",
          "Title": "Количество задач на команде QA",
          "filter": "status in (Resolved, \"In Testing\")",
          "JqlOverride": "",
          "Period": "today",
          "collum": "D"
        },
        {
          "Name": "filter_time_resolved",
          "Title": "Среднее количество дней, которое задачи провели в статусе Resolved",
          "filter": "Resolved",
          "JqlOverride": "",
          "Period": "interval",
		  "limit": "30",
          "collum": "E"
        },
        {
          "Name": "filter_time_in_testing",
          "Title": "Среднее количество дней, которое задачи провели в статусе In Testing",
          "filter": "In Testing",
          "JqlOverride": "",
          "Period": "interval",
		  "limit": "4",
          "collum": "F"
        },
        {
          "Name": "filter_time_ready_to_deploy",
          "Title": "Среднее количество дней, которое задачи провели в статусе Ready to Deploy",
          "filter": "Ready To Deploy",
          "JqlOverride": "",
          "Period": "interval",
		      "limit": "14",
          "collum": "G"
        }
      ]
    }
  ]
} 
